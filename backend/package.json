{
  "name": "sabikids-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API NestJS, GraphQL y servicio TCP para Sabikids",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:microservice": "node dist/progress-microservice.js",
    "start:microservice:dev": "nest start --entryFile progress-microservice --watch",
    "start:microservice:prod": "node dist/progress-microservice.js",
    "test": "node --experimental-strip-types --test test/*.test.mts"
  },
  "dependencies": {
    "@apollo/server": "^5.3.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/microservices": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "graphql": "^16.11.0",
    "mysql2": "^3.15.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.3.2",
    "@types/node": "^24.10.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
